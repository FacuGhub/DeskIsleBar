<Window x:Class="DeskIsleBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskIsleBar" Width="480" Height="390"
        PreviewKeyDown="Ventana_PreviewKeyDown" Deactivated="Ventana_Deactivated"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style x:Key="BotonMusica" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonAcceso" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="#14FFFFFF" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#47FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconoAcceso" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextoAcceso" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Interruptor estilo iOS -->
        <Style x:Key="Interruptor" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Pista" Width="36" Height="20" CornerRadius="10" Background="#40FFFFFF">
                            <Ellipse x:Name="Perilla" Width="16" Height="16" Fill="White" Margin="2,0" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pista" Property="Background" Value="#FF30D158"/>
                                <Setter TargetName="Perilla" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Opcion tipo "chip" (seleccion unica de app de musica) -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fondo" Background="#1AFFFFFF" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Texto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#F2FFFFFF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton de texto chico. Background = color al pasar el mouse: neutro por defecto; los que cierran o borran
             (Cerrar DeskIsleBar, Liberar espacio) usan BotonTextoPeligro, en rojo -->
        <Style x:Key="BotonTexto" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="#14FFFFFF" CornerRadius="11" Padding="10,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonTextoPeligro" TargetType="Button" BasedOn="{StaticResource BotonTexto}">
            <Setter Property="Background" Value="#33FF453A"/>
        </Style>

        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="#1AFFFFFF" CornerRadius="11" Padding="11,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#400A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton de icono chico y neutro (flechas del calendario) -->
        <Style x:Key="BotonIcono" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="9" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link de texto chico ("¿Cómo?") -->
        <Style x:Key="BotonLink" TargetType="Button">
            <Setter Property="Foreground" Value="#FF0A84FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#FF0A84FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Fondo" Background="#1FFFFFFF" CornerRadius="8" Padding="8,5" BorderThickness="1" BorderBrush="#33FFFFFF">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="#660A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Texto que parece una etiqueta pero se edita al hacer clic (nombre de un calendario) -->
        <Style x:Key="CampoEnLinea" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#FF0A84FF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="6" Padding="4,1" BorderThickness="1" BorderBrush="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="#660A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bloq Mayus: una teclita blanca con la "A" (se lee bien aunque sea chica) -->
        <Style x:Key="TeclaMayus" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Flechas a los costados de los paneles -->
        <Style x:Key="FlechaPanel" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF000000"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2C2C2E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Etiquetitas de la bienvenida (lo que hay en Opciones) -->
        <Style x:Key="EtiquetaDemo" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="TextElement.Foreground" Value="#D9FFFFFF"/>
            <Setter Property="TextElement.FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="ValorPc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Margin" Value="0,1,0,4"/>
        </Style>

        <Style x:Key="BarraEq" TargetType="Rectangle">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="RadiusX" Value="1.5"/>
            <Setter Property="RadiusY" Value="1.5"/>
            <Setter Property="Fill" Value="#FF30D158"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
        </Style>
    </Window.Resources>

    <!-- Las zonas transparentes de la ventana dejan pasar los clics. La Zona (casi transparente, pero
         clickeable) rodea a la pildora para que el mouse la "encuentre" pegado al borde de arriba. -->
    <Grid>
        <Grid x:Name="Zona" Background="#01000000" HorizontalAlignment="Center" VerticalAlignment="Top"
              MouseEnter="Zona_MouseEnter" MouseLeave="Zona_MouseLeave" MouseMove="Zona_MouseMove"
              MouseLeftButtonDown="Zona_MouseLeftButtonDown" PreviewMouseLeftButtonDown="Zona_PreviewMouseLeftButtonDown" MouseWheel="Zona_MouseWheel">
            <Border x:Name="Pildora" Background="#FF000000" Margin="14,4,14,8"
                    Width="96" Height="10" CornerRadius="5"
                    MouseLeftButtonUp="Pildora_Click">

                <Grid>
                    <!-- Reposo con contenido: mini portada + ecualizador, o icono + tiempo del temporizador -->
                    <Grid x:Name="ContenidoReposo" Opacity="0" Margin="5,0,10,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Border x:Name="MiniPortada" CornerRadius="9"/>
                            <TextBlock x:Name="IconoReposo" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel x:Name="Ecualizador" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Style="{StaticResource BarraEq}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Style="{StaticResource BarraEq}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Style="{StaticResource BarraEq}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle Style="{StaticResource BarraEq}"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
                        </StackPanel>

                        <TextBlock x:Name="TiempoReposo" Grid.Column="2" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>

                        <!-- Hora, en el medio, mientras suena musica -->
                        <TextBlock x:Name="RelojReposo" Grid.Column="1" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- En reposo: puntitos de lo que esta en uso (verde camara, naranja microfono, ⇪ Bloq Mayus) -->
                    <StackPanel x:Name="IndicadoresReposo" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,9,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <Ellipse x:Name="PuntoCamara" Width="7" Height="7" Fill="#FF30D158" Margin="3,0" Visibility="Collapsed"/>
                        <Ellipse x:Name="PuntoMicrofono" Width="7" Height="7" Fill="#FFFF9F0A" Margin="3,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <!-- Bloq Mayus a la izquierda, como en el teclado -->
                    <Border x:Name="PuntoBloqMayus" Style="{StaticResource TeclaMayus}" HorizontalAlignment="Left" Margin="10,0,0,0"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="A" Foreground="Black" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Inicio: hora + fecha, clima resumido y lo ultimo escuchado (primer panel cuando no suena nada) -->
                    <Grid x:Name="ContenidoInicio" Opacity="0" Margin="22,0,12,0" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HoraInicio" Foreground="White" FontSize="34" FontWeight="Light" Typography.NumeralAlignment="Tabular"
                                       Margin="0,-4,0,0"/>
                            <TextBlock x:Name="FechaInicio" Style="{StaticResource Etiqueta}" FontSize="11.5" Margin="1,0,0,0"/>
                        </StackPanel>

                        <!-- Clima resumido (el detalle esta en su propio panel) -->
                        <StackPanel x:Name="ClimaInicio" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SimboloInicio" FontFamily="Segoe UI Symbol" FontSize="20" Foreground="#FFFFD60A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TemperaturaInicio" Foreground="White" FontSize="20" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="DescripcionInicio" Style="{StaticResource Etiqueta}" FontSize="11" Margin="1,1,0,0"/>
                        </StackPanel>

                        <!-- Lo ultimo escuchado: clic = abrir la app; ▶ = retomar -->
                        <Border x:Name="TarjetaUltimo" Grid.Column="2" Background="#0FFFFFFF" CornerRadius="14" Padding="7" Margin="16,0,0,0"
                                VerticalAlignment="Center" Cursor="Hand" ToolTip="{DynamicResource Comun.AbrirApp}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40">
                                    <Border CornerRadius="8" Background="#FF2A2A2A">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#80FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="PortadaUltimo" CornerRadius="8"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="9,0,2,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Inicio.LoUltimo}" Style="{StaticResource Etiqueta}" FontSize="10"/>
                                    <TextBlock x:Name="TituloUltimo" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ArtistaUltimo" Foreground="#B3FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="RetomarUltimo" Grid.Column="2" Style="{StaticResource BotonMusica}" Content="&#xE768;" ToolTip="{DynamicResource Inicio.Retomar}"
                                        Click="Play_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Aviso (bateria del joystick, scripts, dispositivos, temporizador) -->
                    <Grid x:Name="ContenidoAviso" Opacity="0" Margin="20,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="Icono" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <!-- Icono de la app (notificaciones), en lugar del glifo -->
                        <Image x:Name="IconoApp" Width="28" Height="28" VerticalAlignment="Center" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Titulo" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="Detalle" Foreground="#B3FFFFFF" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Bateria dibujada: carcasa + relleno proporcional + borne -->
                        <StackPanel x:Name="Bateria" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="17" CornerRadius="4" BorderBrush="#80FFFFFF" BorderThickness="1.5" Padding="2">
                                <Border x:Name="Carga" HorizontalAlignment="Left" CornerRadius="2"/>
                            </Border>
                            <Border Width="2.5" Height="6" CornerRadius="0,1.5,1.5,0" Background="#80FFFFFF" Margin="1,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Volumen: icono + barra + porcentaje -->
                    <Grid x:Name="ContenidoVolumen" Opacity="0" Margin="18,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="IconoVolumen" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="White" Width="20" VerticalAlignment="Center"/>

                        <!-- Pista clickeable mas alta que la barra visible, para que sea facil de agarrar -->
                        <Grid x:Name="PistaVolumen" Grid.Column="1" Margin="12,0" Height="20" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="Pista_MouseLeftButtonDown" MouseMove="Pista_MouseMove" MouseLeftButtonUp="Pista_MouseLeftButtonUp">
                            <Grid Height="6" VerticalAlignment="Center">
                                <Border Background="#33FFFFFF" CornerRadius="3"/>
                                <Border x:Name="BarraVolumen" Background="White" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="EscalaVolumen" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="PorcentajeVolumen" Grid.Column="2" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   Width="32" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Accesos (se llega arrastrando hacia la derecha desde la musica) -->
                    <Grid x:Name="ContenidoHerramientas" Opacity="0" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <StackPanel x:Name="BotonesAccesos" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource BotonAcceso}" Tag="25+5" Click="Temporizador_Click">
                                <StackPanel><TextBlock Style="{StaticResource IconoAcceso}" Text="&#xE916;" Foreground="#FFFF9F0A"/><TextBlock Style="{StaticResource TextoAcceso}" Text="Pomodoro"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource BotonAcceso}" Tag="45+10" Click="Temporizador_Click">
                                <StackPanel><TextBlock Style="{StaticResource IconoAcceso}" Text="&#xE916;" Foreground="#FFFF9F0A"/><TextBlock Style="{StaticResource TextoAcceso}" Text="45 + 10"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource BotonAcceso}" Tag="5" Click="Temporizador_Click">
                                <StackPanel><TextBlock Style="{StaticResource IconoAcceso}" Text="&#xE916;" Foreground="#FF0A84FF"/><TextBlock Style="{StaticResource TextoAcceso}" Text="5 min"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource BotonAcceso}" Tag="15" Click="Temporizador_Click">
                                <StackPanel><TextBlock Style="{StaticResource IconoAcceso}" Text="&#xE916;" Foreground="#FF0A84FF"/><TextBlock Style="{StaticResource TextoAcceso}" Text="15 min"/></StackPanel>
                            </Button>
                            <Button x:Name="BotonCancelarTemporizador" Style="{StaticResource BotonAcceso}" Click="CancelarTemporizador_Click">
                                <StackPanel><TextBlock Style="{StaticResource IconoAcceso}" Text="&#xE71A;" Foreground="#FFFF453A"/><TextBlock Style="{StaticResource TextoAcceso}" Text="{DynamicResource Comun.Cancelar}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource BotonAcceso}" Click="Personalizado_Click">
                                <StackPanel><TextBlock Style="{StaticResource IconoAcceso}" Text="&#xE916;" Foreground="#FFBF5AF2"/><TextBlock Style="{StaticResource TextoAcceso}" Text="{DynamicResource Herr.Personalizado}"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource BotonAcceso}" Click="Opciones_Click">
                                <StackPanel><TextBlock Style="{StaticResource IconoAcceso}" Text="&#xE713;"/><TextBlock Style="{StaticResource TextoAcceso}" Text="{DynamicResource Herr.Opciones}"/></StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Temporizador personalizado: la rueda o los botones lo mueven de a 5 minutos; se recuerda el ultimo -->
                        <Grid x:Name="SelectorPersonalizado" Visibility="Collapsed" Margin="18,0" VerticalAlignment="Center"
                              Background="Transparent" MouseWheel="SelectorPersonalizado_MouseWheel">
                            <Button Style="{StaticResource BotonIcono}" Click="VolverAccesos_Click" ToolTip="{DynamicResource Comun.Volver}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" FontSize="11"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource BotonIcono}" Click="MenosMinutos_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE738;" FontSize="13"/>
                                </Button>
                                <TextBlock x:Name="MinutosPersonalizado" Foreground="White" FontSize="22" FontWeight="SemiBold" Width="96"
                                           TextAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                <Button Style="{StaticResource BotonIcono}" Click="MasMinutos_Click">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE710;" FontSize="13"/>
                                </Button>
                            </StackPanel>
                            <Button Style="{StaticResource BotonAccion}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="IniciarPersonalizado_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE768;" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Herr.Iniciar}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- Opciones (boton del panel de accesos) -->
                    <Grid x:Name="ContenidoOpciones" Opacity="0" Margin="18,0" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center">
                            <!-- Encabezado como el de Calendarios: volver + titulo a la izquierda, cerrar la app a la derecha -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BotonIcono}" Click="Volver_Click" ToolTip="{DynamicResource Comun.Volver}" Margin="-6,0,4,0">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" FontSize="11"/>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Herr.Opciones}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource BotonIcono}" Click="VerBienvenida_Click" ToolTip="{DynamicResource Bien.VerDeNuevo}" Margin="4,0,0,0">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE897;" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource BotonIcono}" Click="BuscarActualizaciones_Click" ToolTip="{DynamicResource Act.Buscar}">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE896;" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource BotonTexto}" Click="Avisos_Click" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEA8F;" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Av.Titulo}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BotonTexto}" Click="VolverAlCentro_Click" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Herr.Centrar}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BotonTextoPeligro}" Click="Salir_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Op.Cerrar}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{DynamicResource Op.ArranqueDetalle}">
                                    <ToggleButton x:Name="InterruptorArranque" Style="{StaticResource Interruptor}" Click="Arranque_Click"/>
                                    <TextBlock Text="{DynamicResource Op.Arranque}" Foreground="White" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" FontSize="10" Foreground="#80FFFFFF"
                                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{DynamicResource Op.FocoDetalle}">
                                    <ToggleButton x:Name="InterruptorFoco" Style="{StaticResource Interruptor}" Click="Foco_Click"/>
                                    <TextBlock Text="{DynamicResource Op.Foco}" Foreground="White" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" FontSize="10" Foreground="#80FFFFFF"
                                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{DynamicResource Op.NotificacionesDetalle}">
                                    <ToggleButton x:Name="InterruptorNotificaciones" Style="{StaticResource Interruptor}" Click="Notificaciones_Click"/>
                                    <TextBlock Text="{DynamicResource Op.Notificaciones}" Foreground="White" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" FontSize="10" Foreground="#80FFFFFF"
                                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{DynamicResource Op.NoMolestarDetalle}">
                                    <ToggleButton x:Name="InterruptorNoMolestar" Style="{StaticResource Interruptor}" Click="Notificaciones_Click"/>
                                    <TextBlock Text="{DynamicResource Op.NoMolestar}" Foreground="White" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" FontSize="10" Foreground="#80FFFFFF"
                                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="{DynamicResource Op.Paneles}" Style="{StaticResource Etiqueta}" Margin="0,14,0,6"/>
                            <UniformGrid Columns="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ToggleButton x:Name="InterruptorCalendario" Style="{StaticResource Interruptor}" Tag="calendario" Click="Panel_Interruptor_Click"/>
                                    <TextBlock Text="{DynamicResource Op.Calendario}" Foreground="White" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ToggleButton x:Name="InterruptorClima" Style="{StaticResource Interruptor}" Tag="clima" Click="Panel_Interruptor_Click"/>
                                    <TextBlock Text="{DynamicResource Op.Clima}" Foreground="White" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="InterruptorPc" Style="{StaticResource Interruptor}" Tag="pc" Click="Panel_Interruptor_Click"/>
                                    <TextBlock Text="{DynamicResource Op.Pc}" Foreground="White" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="InterruptorNotas" Style="{StaticResource Interruptor}" Tag="notas" Click="Panel_Interruptor_Click"/>
                                    <TextBlock Text="{DynamicResource Op.Notas}" Foreground="White" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,6" HorizontalAlignment="Left" Background="Transparent"
                                        ToolTip="{DynamicResource Op.AppMusicaDetalle}">
                                <TextBlock Text="{DynamicResource Op.AppMusica}" Style="{StaticResource Etiqueta}"/>
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" FontSize="10" Foreground="#80FFFFFF"
                                           Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel x:Name="ChipsMusica" Orientation="Horizontal" ToolTip="{DynamicResource Op.AppMusicaDetalle}"/>

                            <!-- Idioma y primer plano comparten fila, cada uno en su mitad -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Op.Idioma}" Style="{StaticResource Etiqueta}" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="ChipsIdioma" Orientation="Horizontal"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource Op.PrimerPlano}" Style="{StaticResource Etiqueta}" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="ChipsPrimerPlano" Orientation="Horizontal"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Op.Ciudad}" Style="{StaticResource Etiqueta}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <TextBox x:Name="CampoCiudad" Style="{StaticResource CampoTexto}" MaxLength="60"
                                                 LostKeyboardFocus="CampoCiudad_LostKeyboardFocus" TextChanged="CampoCiudad_TextChanged"/>
                                        <TextBlock x:Name="PistaCiudad" Text="{DynamicResource Comun.EjemploCiudad}" Foreground="#66FFFFFF" FontSize="12"
                                                   Margin="10,6,0,0" IsHitTestVisible="False"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Op.Calendarios}" Style="{StaticResource Etiqueta}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <TextBlock x:Name="ResumenCalendarios" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource BotonAccion}" HorizontalAlignment="Right" Click="AdministrarCalendarios_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE787;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TextoBotonCalendarios" Text="{DynamicResource Op.AdministrarCalendarios}"/>
                                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Estado de la PC -->
                    <Grid x:Name="ContenidoPc" Opacity="0" Margin="22,14,18,20" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Liberar espacio: analizar → confirmar → limpiar (es irreversible) -->
                        <Border Grid.Row="1" Grid.ColumnSpan="7" Background="#0FFFFFFF" CornerRadius="12" Padding="12,6,6,6" Margin="0,12,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EstadoLimpieza" Text="{DynamicResource Pc.TemporalesYPapelera}" Foreground="#B3FFFFFF" FontSize="11.5" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BotonAnalizarLimpieza" Style="{StaticResource BotonAccion}" Content="{DynamicResource Pc.Liberar}" Click="AnalizarLimpieza_Click"/>
                                    <Button x:Name="BotonCancelarLimpieza" Style="{StaticResource BotonAccion}" Content="{DynamicResource Comun.Cancelar}" Click="CancelarLimpieza_Click"
                                            Visibility="Collapsed"/>
                                    <Button x:Name="BotonConfirmarLimpieza" Style="{StaticResource BotonTextoPeligro}" Click="ConfirmarLimpieza_Click"
                                            Visibility="Collapsed" Margin="6,0,0,0" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CPU" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="ValorCpu" Style="{StaticResource ValorPc}"/>
                            <Grid Height="4"><Border Background="#26FFFFFF" CornerRadius="2"/><Border x:Name="BarraCpu" Width="0" Background="#FF0A84FF" CornerRadius="2" HorizontalAlignment="Left"/></Grid>
                        </StackPanel>
                        <StackPanel x:Name="ColumnaGpu" Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="GPU" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="ValorGpu" Style="{StaticResource ValorPc}"/>
                            <Grid Height="4"><Border Background="#26FFFFFF" CornerRadius="2"/><Border x:Name="BarraGpu" Width="0" Background="#FF30D158" CornerRadius="2" HorizontalAlignment="Left"/></Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="RAM" Style="{StaticResource Etiqueta}"/>
                            <TextBlock x:Name="ValorRam" Style="{StaticResource ValorPc}"/>
                            <Grid Height="4"><Border Background="#26FFFFFF" CornerRadius="2"/><Border x:Name="BarraRam" Width="0" Background="#FFFF9F0A" CornerRadius="2" HorizontalAlignment="Left"/></Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="6" VerticalAlignment="Center">
                            <TextBlock x:Name="DetalleRam" Foreground="#CCFFFFFF" FontSize="11.5"/>
                            <TextBlock Text="{DynamicResource Pc.Encendida}" Style="{StaticResource Etiqueta}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ValorEncendida" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Notas rapidas: al hacer clic en el texto la isla toma el teclado -->
                    <Grid x:Name="ContenidoNotas" Opacity="0" Margin="22,0,22,16" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Cabecera alta: zona libre para agarrar el panel y arrastrarlo -->
                        <StackPanel Orientation="Horizontal" Margin="4,16,0,10">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70B;" FontSize="12" Foreground="#FFFFD60A" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Notas.Titulo}" Style="{StaticResource Etiqueta}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <TextBox x:Name="CampoNotas" Style="{StaticResource CampoTexto}" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" TextChanged="CampoNotas_TextChanged"/>
                            <TextBlock x:Name="PistaNotas" Text="{DynamicResource Notas.Pista}" Foreground="#4DFFFFFF" FontSize="12"
                                       Margin="10,6,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <!-- Clima -->
                    <Grid x:Name="ContenidoClima" Opacity="0" Margin="22,0" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid x:Name="DatosClima">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SimboloClima" FontFamily="Segoe UI Symbol" FontSize="34" Foreground="#FFFFD60A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TemperaturaClima" Foreground="White" FontSize="34" FontWeight="Light" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DescripcionClima" Foreground="White" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LugarClima" Style="{StaticResource Etiqueta}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="MaxMinClima" Foreground="White" FontSize="12" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="ExtraClima" Style="{StaticResource Etiqueta}" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ProblemaClima" Foreground="#B3FFFFFF" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Calendario: mini mes + proximos eventos -->
                    <Grid x:Name="ContenidoCalendario" Opacity="0" Margin="16,14,14,20" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mini mes -->
                        <StackPanel VerticalAlignment="Top">
                            <!-- Mes: nombre (clic = volver a hoy) + ‹ › -->
                            <Grid Margin="0,0,0,6" Height="22">
                                <Button Style="{StaticResource BotonLink}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="MesCalendario_Click" ToolTip="{DynamicResource Cal.VolverAHoy}">
                                    <TextBlock x:Name="MesCalendario" Foreground="#FFFF453A" FontSize="13" FontWeight="SemiBold" Margin="3,0,0,0"/>
                                </Button>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="MesAnterior" Style="{StaticResource BotonIcono}" Click="MesAnterior_Click" ToolTip="{DynamicResource Cal.MesAnterior}">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" FontSize="10"/>
                                    </Button>
                                    <Button x:Name="MesSiguiente" Style="{StaticResource BotonIcono}" Click="MesSiguiente_Click" ToolTip="{DynamicResource Cal.MesSiguiente}">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <!-- Iniciales aparte: en la misma UniformGrid tomarian el alto de una semana -->
                            <UniformGrid x:Name="InicialesCalendario" Columns="7"/>
                            <UniformGrid x:Name="DiasCalendario" Columns="7"/>
                        </StackPanel>

                        <!-- Tarjeta de eventos: proximos o los del dia elegido -->
                        <Border Grid.Column="2" Background="#0FFFFFFF" CornerRadius="14" Padding="12,9,8,10">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Height="22">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="VolverAProximos" Style="{StaticResource BotonIcono}" Click="VolverAProximos_Click" Visibility="Collapsed"
                                                ToolTip="{DynamicResource Cal.VolverAProximos}" Margin="-6,0,2,0">
                                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" FontSize="10"/>
                                        </Button>
                                        <TextBlock x:Name="TituloEventos" Text="{DynamicResource Cal.Proximos}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource BotonIcono}" HorizontalAlignment="Right" ToolTip="{DynamicResource Cal.Administrar}"
                                            Click="ConfigurarCalendariosDesdePanel_Click">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE713;" FontSize="11"/>
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="EventosCalendario"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Musica: portada + tema/artista/progreso + controles -->
                    <Grid x:Name="ContenidoMusica" Opacity="0" Margin="14,0,12,0" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="ZonaPortada" Width="60" Height="60" VerticalAlignment="Center" Cursor="Hand" ToolTip="{DynamicResource Comun.AbrirApp}">
                            <Border CornerRadius="10" Background="#FF2A2A2A">
                                <TextBlock x:Name="SinPortada" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="22" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Portada" CornerRadius="10"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                            <StackPanel x:Name="InfoTema" Background="Transparent" Cursor="Hand">
                                <TextBlock x:Name="TituloMusica" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistaMusica" Foreground="#B3FFFFFF" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Grid x:Name="Progreso" Margin="0,3,0,-6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Pista clickeable mas alta que la barra visible -->
                                <Grid x:Name="PistaProgreso" Height="18" Background="Transparent"
                                      MouseLeftButtonDown="Pista_MouseLeftButtonDown" MouseMove="Pista_MouseMove" MouseLeftButtonUp="Pista_MouseLeftButtonUp">
                                    <Grid x:Name="BarraProgreso" Height="3" VerticalAlignment="Center">
                                        <Border Background="#33FFFFFF" CornerRadius="1.5"/>
                                        <Border Background="#E6FFFFFF" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="EscalaProgreso" ScaleX="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="TiempoMusica" Grid.Column="1" Margin="8,0,0,0" FontSize="10.5" Foreground="#99FFFFFF"
                                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BotonAnterior" Style="{StaticResource BotonMusica}" Content="&#xE892;" Click="Anterior_Click"/>
                            <Button x:Name="BotonPlay" Style="{StaticResource BotonMusica}" Content="&#xE768;" FontSize="20" Width="42" Height="42" Click="Play_Click"/>
                            <Button x:Name="BotonSiguiente" Style="{StaticResource BotonMusica}" Content="&#xE893;" Click="Siguiente_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Avisos: un interruptor por tipo de aviso (se arman desde TiposAviso) -->
                    <Grid x:Name="ContenidoAvisos" Opacity="0" Margin="22,0" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource BotonIcono}" Click="Volver_Click" ToolTip="{DynamicResource Comun.Volver}" Margin="-6,0,4,0">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" FontSize="11"/>
                                </Button>
                                <TextBlock Text="{DynamicResource Av.Titulo}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <UniformGrid x:Name="InterruptoresAvisos" Columns="2"/>
                        </StackPanel>
                    </Grid>

                    <!-- Calendarios vinculados: lista (links ocultos) + fila para agregar -->
                    <Grid x:Name="ContenidoCalendarios" Opacity="0" Margin="22,0" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BotonIcono}" Click="Volver_Click" ToolTip="{DynamicResource Comun.Volver}" Margin="-6,0,4,0">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" FontSize="11"/>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Cals.Titulo}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Style="{StaticResource BotonLink}" Content="{DynamicResource Cals.ComoConsigo}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Tutorial_Click"/>
                            </Grid>

                            <StackPanel x:Name="ListaCalendarios"/>

                            <Grid x:Name="FilaAgregarCalendario" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="CampoNombreCalendario" Style="{StaticResource CampoTexto}" MaxLength="24" TextChanged="CampoCalendario_TextChanged"/>
                                    <TextBlock x:Name="PistaNombreCalendario" Text="{DynamicResource Cals.Nombre}" Foreground="#4DFFFFFF" FontSize="12" Margin="10,6,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <TextBox x:Name="CampoLinkCalendario" Style="{StaticResource CampoTexto}" TextChanged="CampoCalendario_TextChanged"/>
                                    <TextBlock x:Name="PistaLinkCalendario" Text="{DynamicResource Cals.PistaLink}" Foreground="#4DFFFFFF" FontSize="12" Margin="10,6,0,0" IsHitTestVisible="False"/>
                                </Grid>
                                <Button Grid.Column="4" Style="{StaticResource BotonAccion}" Click="AgregarCalendario_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE710;" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Cals.Agregar}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="ErrorCalendario" Foreground="#FFFF453A" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tutorial para vincular el calendario (desde el panel de calendario u Opciones) -->
                    <Grid x:Name="ContenidoTutorial" Opacity="0" Margin="22,0" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BotonIcono}" Click="Volver_Click" ToolTip="{DynamicResource Comun.Volver}" Margin="-6,0,4,0">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" FontSize="11"/>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Tut.Titulo}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton x:Name="TutorialGoogle" Style="{StaticResource Chip}" Content="Google" GroupName="Tutorial" Tag="google" Click="TutorialProveedor_Click"/>
                                    <RadioButton Style="{StaticResource Chip}" Content="Outlook" GroupName="Tutorial" Tag="outlook" Click="TutorialProveedor_Click" Margin="0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="PasosTutorial" Margin="0,14,0,0"/>

                            <TextBlock Text="{DynamicResource Tut.Privado}"
                                       Style="{StaticResource Etiqueta}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Style="{StaticResource BotonAccion}" Click="AbrirConfigCalendario_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Tut.AbrirConfig}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BotonAccion}" Margin="8,0,0,0" Click="YaTengoElLink_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Tut.YaTengo}"/>
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE72A;" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Bienvenida: la primera vez que se abre (y desde Opciones → ?). Cada paso muestra su demo; los de
                         accion (cambiar de panel, mover, volumen) esperan a que se haga. Ver MainWindow.Bienvenida.cs -->
                    <Grid x:Name="ContenidoBienvenida" Opacity="0" Margin="22,16,22,22" Visibility="Collapsed" Background="Transparent"
                          PreviewMouseLeftButtonDown="Panel_PreviewMouseLeftButtonDown" PreviewMouseMove="Panel_PreviewMouseMove" PreviewMouseLeftButtonUp="Panel_PreviewMouseLeftButtonUp">
                        <Grid.RenderTransform>
                            <TranslateTransform/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock x:Name="TituloBienvenida" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button x:Name="SaltarBienvenida" Style="{StaticResource BotonLink}" Content="{DynamicResource Bien.Saltar}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="SaltarBienvenida_Click"/>
                        </Grid>
                        <TextBlock x:Name="TextoBienvenida" Grid.Row="1" Foreground="#D9FFFFFF" FontSize="12.5" TextWrapping="Wrap"
                                   LineHeight="18" Margin="0,8,0,0"/>

                        <Grid Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center">
                            <!-- Hola: idioma -->
                            <StackPanel x:Name="DemoHola" Orientation="Horizontal" Visibility="Collapsed"/>

                            <!-- Cambiar de panel: tres paneles en miniatura que pasan, y un "dedo" que arrastra -->
                            <Grid x:Name="DemoPaneles" Visibility="Collapsed" HorizontalAlignment="Left">
                                <Border Width="150" Height="40" CornerRadius="10" ClipToBounds="True" Background="#0FFFFFFF">
                                    <StackPanel x:Name="CarruselDemo" Orientation="Horizontal">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform/>
                                        </StackPanel.RenderTransform>
                                        <TextBlock Width="150" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8D6;" FontSize="18" Foreground="#FF30D158"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Width="150" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE787;" FontSize="18" Foreground="#FFFF9F0A"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Width="150" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE706;" FontSize="18" Foreground="#FFFFD60A"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Ellipse x:Name="DedoDemo" Width="16" Height="16" Fill="#59FFFFFF" Stroke="#CCFFFFFF" StrokeThickness="1.5"
                                         VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>

                            <!-- Mover: una pantalla en miniatura donde la pildora cambia de lugar, y el boton Centrar -->
                            <StackPanel x:Name="DemoMover" Orientation="Horizontal" Visibility="Collapsed">
                                <Border Width="96" Height="56" CornerRadius="6" BorderBrush="#4DFFFFFF" BorderThickness="1">
                                    <Border x:Name="PildoraDemo" Width="24" Height="6" CornerRadius="3" Background="#E6FFFFFF"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.RenderTransform>
                                            <TranslateTransform/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <Button Style="{StaticResource BotonAccion}" Click="VolverAlCentro_Click" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE80F;" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Herr.Centrar}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Volumen: un mouse con la ruedita que gira, y la barra que se mueve de verdad -->
                            <StackPanel x:Name="DemoVolumen" Orientation="Horizontal" Visibility="Collapsed">
                                <Border Width="22" Height="32" CornerRadius="11" BorderBrush="#99FFFFFF" BorderThickness="1.5">
                                    <Border x:Name="RuedaDemo" Width="3" Height="7" CornerRadius="1.5" Background="White"
                                            VerticalAlignment="Top" Margin="0,5,0,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE767;" FontSize="14" Foreground="White"
                                           VerticalAlignment="Center" Margin="18,0,10,0"/>
                                <Grid Width="150" Height="4" VerticalAlignment="Center">
                                    <Border Background="#26FFFFFF" CornerRadius="2"/>
                                    <Border Background="White" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="EscalaVolumenDemo" ScaleX="0"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="PorcentajeVolumenDemo" Foreground="White" FontSize="12" FontWeight="SemiBold" MinWidth="28"
                                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <!-- Calendario: dos eventos de ejemplo, para que se vea que existe -->
                            <Border x:Name="DemoCalendario" Visibility="Collapsed" Background="#0FFFFFFF" CornerRadius="10" Padding="12,7"
                                    HorizontalAlignment="Left" MinWidth="230">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#FF0A84FF" VerticalAlignment="Center"/>
                                        <TextBlock Text="10:00" Foreground="#99FFFFFF" FontSize="11.5" Margin="8,0,8,0" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="{DynamicResource Bien.Calendario.Ejemplo1}" Foreground="White" FontSize="11.5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Ellipse Width="7" Height="7" Fill="#FFFF9F0A" VerticalAlignment="Center"/>
                                        <TextBlock Text="18:30" Foreground="#99FFFFFF" FontSize="11.5" Margin="8,0,8,0" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="{DynamicResource Bien.Calendario.Ejemplo2}" Foreground="White" FontSize="11.5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Clima: la ciudad -->
                            <Grid x:Name="DemoClima" Visibility="Collapsed" Width="240" HorizontalAlignment="Left">
                                <TextBox x:Name="CampoCiudadBienvenida" Style="{StaticResource CampoTexto}" MaxLength="60"
                                         TextChanged="CampoCiudadBienvenida_TextChanged"/>
                                <TextBlock x:Name="PistaCiudadBienvenida" Text="{DynamicResource Comun.EjemploCiudad}" Foreground="#66FFFFFF" FontSize="12"
                                           Margin="10,6,0,0" IsHitTestVisible="False"/>
                            </Grid>

                            <!-- Opciones: lo que hay adentro -->
                            <WrapPanel x:Name="DemoOpciones" Visibility="Collapsed">
                                <Border Style="{StaticResource EtiquetaDemo}"><TextBlock Text="{DynamicResource Op.Paneles}"/></Border>
                                <Border Style="{StaticResource EtiquetaDemo}"><TextBlock Text="{DynamicResource Av.Titulo}"/></Border>
                                <Border Style="{StaticResource EtiquetaDemo}"><TextBlock Text="{DynamicResource Op.Idioma}"/></Border>
                                <Border Style="{StaticResource EtiquetaDemo}"><TextBlock Text="{DynamicResource Op.AppMusica}"/></Border>
                                <Border Style="{StaticResource EtiquetaDemo}"><TextBlock Text="{DynamicResource Op.PrimerPlano}"/></Border>
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <TextBlock x:Name="PistaBienvenida" FontSize="11.5" Foreground="#FF0A84FF" VerticalAlignment="Center"/>
                            <Button x:Name="SiguienteBienvenida" Style="{StaticResource BotonAccion}" HorizontalAlignment="Right" Click="SiguienteBienvenida_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TextoSiguienteBienvenida"/>
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- "En uso" (camara, microfono, Bloq Mayus) abajo del primer panel, sea Inicio o Musica -->
                    <StackPanel x:Name="EnUso" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="22,0,22,17" Visibility="Collapsed" IsHitTestVisible="False"/>

                    <!-- Destello del borde cuando empieza a usarse la camara o el microfono, o se prende Bloq Mayus -->
                    <Border x:Name="Destello" BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                            CornerRadius="{Binding CornerRadius, ElementName=Pildora}"/>

                    <!-- Indicador de pagina de la ronda de paneles (se arma en codigo): cada puntito lleva a su panel -->
                    <StackPanel x:Name="Puntos" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,1" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Flechas para pasar de panel: afuera de la pildora (en el margen de la zona) para no tapar el contenido.
                 Aparecen al acercar el mouse a un costado (ver Zona_MouseMove) -->
            <Border x:Name="FlechaIzquierda" Tag="-1" Style="{StaticResource FlechaPanel}" HorizontalAlignment="Left" Margin="0,0,0,4"
                    MouseLeftButtonDown="Flecha_MouseLeftButtonDown">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76B;" FontSize="8" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="FlechaDerecha" Tag="1" Style="{StaticResource FlechaPanel}" HorizontalAlignment="Right" Margin="0,0,0,4"
                    MouseLeftButtonDown="Flecha_MouseLeftButtonDown">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE76C;" FontSize="8" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
