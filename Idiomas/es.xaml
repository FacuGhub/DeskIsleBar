    <!-- Tutorial para vincular el calendario -->
    <sys:String x:Key="Tut.Titulo">Vincular tu calendario</sys:String>
    <sys:String x:Key="Tut.Privado">El link es privado: con él se pueden ver tus eventos. No lo compartas; DeskIsleBar lo guarda solo en esta PC.</sys:String>
    <sys:String x:Key="Tut.AbrirConfig">Abrir la configuración</sys:String>
    <sys:String x:Key="Tut.YaTengo">Ya tengo el link</sys:String>
    <sys:String x:Key="Tut.Google1">Abrí Google Calendar en la compu y entrá a ⚙ Configuración.</sys:String>
    <sys:String x:Key="Tut.Google2">A la izquierda, en «Configuración de mis calendarios», elegí tu calendario.</sys:String>
    <sys:String x:Key="Tut.Google3">Bajá hasta «Integrar el calendario» y copiá la «Dirección secreta en formato iCal».</sys:String>
    <sys:String x:Key="Tut.Google4">Tocá «Ya tengo el link» y pegalo con Ctrl+V.</sys:String>
    <sys:String x:Key="Tut.Outlook1">Abrí Outlook.com y entrá a ⚙ Configuración → Calendario → Calendarios compartidos.</sys:String>
    <sys:String x:Key="Tut.Outlook2">En «Publicar un calendario», elegí tu calendario y «Puede ver todos los detalles».</sys:String>
    <sys:String x:Key="Tut.Outlook3">Tocá «Publicar» y copiá el vínculo ICS.</sys:String>
    <sys:String x:Key="Tut.Outlook4">Tocá «Ya tengo el link» y pegalo con Ctrl+V.</sys:String>

