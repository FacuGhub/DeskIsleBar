    <!-- Tutorial for linking the calendar -->
    <sys:String x:Key="Tut.Titulo">Link your calendar</sys:String>
    <sys:String x:Key="Tut.Privado">The link is private: anyone who has it can see your events. Don't share it; DeskIsleBar keeps it only on this PC.</sys:String>
    <sys:String x:Key="Tut.AbrirConfig">Open settings</sys:String>
    <sys:String x:Key="Tut.YaTengo">I have the link</sys:String>
    <sys:String x:Key="Tut.Google1">Open Google Calendar on your computer and go to ⚙ Settings.</sys:String>
    <sys:String x:Key="Tut.Google2">On the left, under “Settings for my calendars”, choose your calendar.</sys:String>
    <sys:String x:Key="Tut.Google3">Scroll down to “Integrate calendar” and copy the “Secret address in iCal format”.</sys:String>
    <sys:String x:Key="Tut.Google4">Click “I have the link” and paste it with Ctrl+V.</sys:String>
    <sys:String x:Key="Tut.Outlook1">Open Outlook.com and go to ⚙ Settings → Calendar → Shared calendars.</sys:String>
    <sys:String x:Key="Tut.Outlook2">Under “Publish a calendar”, choose your calendar and “Can view all details”.</sys:String>
    <sys:String x:Key="Tut.Outlook3">Click “Publish” and copy the ICS link.</sys:String>
    <sys:String x:Key="Tut.Outlook4">Click “I have the link” and paste it with Ctrl+V.</sys:String>

